.github
.venv
.env
.env.*
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.crt
**/*.p12
**/*.pfx
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov
dist
build
*.egg-info
.DS_Store
.idea
.vscode
tests
scripts
docs
requirements.txt
CHANGELOG.md
Dockerfile
.dockerignore
