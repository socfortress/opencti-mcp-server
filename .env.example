# OpenCTI (use a read-only service account; see README "OpenCTI service account")
OPENCTI_URL=https://opencti.example.com
OPENCTI_TOKEN=change-me
OPENCTI_VERIFY_TLS=true
# OPENCTI_CA_CERT=/certs/root-ca.pem
OPENCTI_TIMEOUT=30
OPENCTI_MAX_TLP=TLP:AMBER+STRICT
# OPENCTI_EXTRA_TLP=TLP:EX:CHR:3        # rank operator-defined TLP markings; other unknown ones are withheld
# OPENCTI_HIDE_WITHHELD_COUNTS=false
OPENCTI_MAX_FIRST=50

# MCP server (HTTP transport refuses to start without a token; it must differ from OPENCTI_TOKEN)
MCP_AUTH_TOKEN=change-me-to-at-least-32-characters   # openssl rand -hex 32
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
MCP_MAX_OUTPUT_CHARS=20000
# MCP_ALLOWED_HOSTS=opencti-mcp:8000   # enables DNS-rebinding protection for these Host values
